{
    "name": "benchmark/php-validator-benchmarks",
    "description": "Benchmarking 10 PHP validation approaches across PHP 8.2 - 8.5",
    "type": "project",
    "require": {
        "php": "^8.2",
        "cuyz/valinor": "^2.6",
        "illuminate/translation": "^12.0",
        "illuminate/validation": "^12.0",
        "respect/validation": "^2.3 || ^3.1",
        "symfony/validator": "^7.4 || ^8.1",
        "webmozart/assert": "^2.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Bench\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bench\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
